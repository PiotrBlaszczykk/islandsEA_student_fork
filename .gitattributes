# Keep repository text files stable across Windows/Linux.
* text=auto eol=lf

# Source and experiment configuration files.
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary artifacts.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.gz binary
*.zip binary
*.tar binary
*.tgz binary
*.pkl binary
*.npy binary
*.npz binary
