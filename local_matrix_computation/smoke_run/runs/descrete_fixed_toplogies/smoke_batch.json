{
  "schema_version": 1,
  "experiment_name": "smoke_descrete_fixed_toplogies",
  "experiment_key": "descrete_fixed_toplogies",
  "description": "Tiny local smoke batch for the local Ray benchmark pipeline.",
  "defaults": {
    "variables": 12,
    "evaluations": 96,
    "population_size": 8,
    "offspring_population_size": 4,
    "migrants": 1,
    "migration_interval": 12,
    "accept_strategy": "BEZ",
    "compress_timeseries": false,
    "cleanup_run_dir": false
  },
  "execution": {
    "max_parallel_jobs": 1,
    "runner": "islands_desync/students_tests/continous_benchmarks/run_local_benchmark.py",
    "recommended_command": "python local_matrix_computation/run_batch.py local_matrix_computation/smoke_run/runs/descrete_fixed_toplogies/smoke_batch.json"
  },
  "jobs": [
    {
      "job_index": 1,
      "benchmark_name": "smoke_descrete_labs_binary_ring_random",
      "problem": "labs_binary",
      "problem_kind": "descrete",
      "variables": 20,
      "topology": "ring",
      "islands": 12,
      "ray_num_cpus": 12,
      "migrant_strategy": "random",
      "repeat": 1,
      "date_tag": "smoke_descrete_fixed_toplogies",
      "time_tag": "s0001",
      "output_base": "local_matrix_computation/smoke_run/results/descrete_fixed_toplogies"
    },
    {
      "job_index": 2,
      "benchmark_name": "smoke_descrete_nk_k4_complete_best",
      "problem": "nk_k4",
      "problem_kind": "descrete",
      "variables": 20,
      "topology": "complete",
      "islands": 12,
      "ray_num_cpus": 12,
      "migrant_strategy": "best",
      "repeat": 1,
      "date_tag": "smoke_descrete_fixed_toplogies",
      "time_tag": "s0002",
      "output_base": "local_matrix_computation/smoke_run/results/descrete_fixed_toplogies"
    }
  ]
}
